//@version=6
// Quant Day Trader: intraday strategy that only trades in the cash session and is flat every night.
//
// Each closed candle gets a quant SCORE from -4 to +4 (one vote per signal):
//   1. Trend      : EMA 20 vs EMA 50 and price vs session VWAP
//   2. Momentum   : volatility-adjusted momentum z-score
//   3. Breakout   : price above / below the opening range (first 15 min)
//   4. Probability: Naive Bayes P(next candle up), learned walk-forward
// Filters: relative volume, VWAP z-score (no chasing overextended moves), session time,
//          max trades per day, daily loss limit.
// Risk: ATR stop loss and ATR take profit on every trade, everything closed before the session ends.
//
// Use on a 1 min or 5 min chart of a liquid market (MNQ, NQ, ES, SPY, QQQ).
// Check the Strategy Tester before trusting it. Research tool, not financial advice.
strategy("Quant Day Trader", shorttitle = "QDT", overlay = true, initial_capital = 10000,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.62,
     slippage = 1, calc_on_every_tick = false, process_orders_on_close = false,
     margin_long = 0, margin_short = 0)

// ---------------------------------------------------------------- inputs
tz        = input.string("America/New_York", "Time zone", group = "Session")
sess      = input.session("0945-1550", "Trading window (new entries)", group = "Session")
orSess    = input.session("0930-0945", "Opening range", group = "Session")
flatSess  = input.session("0930-1555", "Hold positions only inside", group = "Session")
minScore  = input.int(3, "Score needed to enter (1-4)", minval = 1, maxval = 4, group = "Signals")
pTh       = input.float(0.55, "Probability vote threshold", minval = 0.5, maxval = 0.9, step = 0.01, group = "Signals")
momLen    = input.int(10, "Momentum length", minval = 2, group = "Signals")
relVolMin = input.float(1.0, "Min relative volume", minval = 0.0, step = 0.1, group = "Signals")
maxZ      = input.float(2.0, "Max VWAP z-score (no chasing)", minval = 0.5, step = 0.1, group = "Signals")
slMult    = input.float(1.5, "Stop loss (x ATR)", minval = 0.1, step = 0.1, group = "Risk")
tpMult    = input.float(2.5, "Take profit (x ATR)", minval = 0.1, step = 0.1, group = "Risk")
maxTrades = input.int(3, "Max trades per day", minval = 1, group = "Risk")
maxLoss   = input.float(300, "Daily loss limit ($)", minval = 0, group = "Risk")
allowShort = input.bool(true, "Allow shorts", group = "Risk")

// ---------------------------------------------------------------- time
inTrade = not na(time(timeframe.period, sess, tz))
inHold  = not na(time(timeframe.period, flatSess, tz))
inOR    = not na(time(timeframe.period, orSess, tz))
dayStart = inHold and not inHold[1]

// ---------------------------------------------------------------- quant inputs
atr    = ta.atr(14)
ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
vwapV  = ta.vwap(hlc3)
ret    = math.log(close / close[1])
volRet = ta.stdev(ret, 100)
momZ   = volRet > 0 ? math.log(close / close[momLen]) / (volRet * math.sqrt(momLen)) : 0.0
dev    = close - vwapV
devSd  = ta.stdev(dev, 100)
vwapZ  = devSd > 0 ? dev / devSd : 0.0
volSma = ta.sma(volume, 20)
relVol = volSma > 0 ? volume / volSma : 1.0

// opening range
var float orH = na
var float orL = na
if inOR and not inOR[1]
    orH := high
    orL := low
else if inOR
    orH := math.max(orH, high)
    orL := math.min(orL, low)
orReady = not inOR and not na(orH) and inHold

// Naive Bayes P(next candle closes up), walk-forward with slowly fading counts
nbProb() =>
    int y = close > close[1] ? 1 : 0
    float r = ta.rsi(close, 14)
    int b1 = na(r) ? 1 : r < 40 ? 0 : r > 60 ? 2 : 1
    float clv = high > low ? (2 * close - high - low) / (high - low) : 0.0
    int b2 = clv < -0.33 ? 0 : clv > 0.33 ? 2 : 1
    int b3 = close > nz(ta.ema(close, 50), close) ? 1 : 0
    int b4 = 2 * nz(y[1]) + y
    int b5 = nz(volume) > nz(ta.sma(nz(volume), 20)) ? 1 : 0
    var array<float> cls = array.new<float>(2, 0.0)
    var array<float> cnt = array.new<float>(28, 0.0)
    sizes = array.from(3.0, 3.0, 2.0, 4.0, 2.0)
    prevIdx = array.from(nz(b1[1], 1), 3 + nz(b2[1], 1), 6 + nz(b3[1], 0), 8 + nz(b4[1], 0), 12 + nz(b5[1], 0))
    if bar_index > 2
        for i = 0 to 1
            cls.set(i, cls.get(i) * 0.997)
        for i = 0 to 27
            cnt.set(i, cnt.get(i) * 0.997)
        cls.set(y, cls.get(y) + 1.0)
        for i = 0 to 4
            k = y * 14 + prevIdx.get(i)
            cnt.set(k, cnt.get(k) + 1.0)
    nowIdx = array.from(b1, 3 + b2, 6 + b3, 8 + b4, 12 + b5)
    n0 = cls.get(0)
    n1 = cls.get(1)
    float lp0 = math.log((n0 + 1.0) / (n0 + n1 + 2.0))
    float lp1 = math.log((n1 + 1.0) / (n0 + n1 + 2.0))
    for i = 0 to 4
        j = nowIdx.get(i)
        lp0 += math.log((cnt.get(j) + 1.0) / (n0 + sizes.get(i)))
        lp1 += math.log((cnt.get(14 + j) + 1.0) / (n1 + sizes.get(i)))
    1.0 / (1.0 + math.exp(math.max(-30.0, math.min(30.0, lp0 - lp1))))

pUp = nbProb()

// ---------------------------------------------------------------- score
vTrend = ema20 > ema50 and close > vwapV ? 1 : ema20 < ema50 and close < vwapV ? -1 : 0
vMom   = momZ > 0.5 ? 1 : momZ < -0.5 ? -1 : 0
vOR    = orReady and close > orH ? 1 : orReady and close < orL ? -1 : 0
vProb  = pUp >= pTh ? 1 : pUp <= 1 - pTh ? -1 : 0
score  = vTrend + vMom + vOR + vProb

// ---------------------------------------------------------------- risk state
var int tradesToday = 0
var float dayEquity = strategy.initial_capital
if dayStart
    tradesToday := 0
    dayEquity := strategy.equity
dayPnL = strategy.equity - dayEquity
lossHit = maxLoss > 0 and dayPnL <= -maxLoss
canTrade = inTrade and orReady and tradesToday < maxTrades and not lossHit and strategy.position_size == 0 and barstate.isconfirmed

longCond  = canTrade and score >= minScore and relVol >= relVolMin and vwapZ < maxZ
shortCond = canTrade and allowShort and score <= -minScore and relVol >= relVolMin and vwapZ > -maxZ

// ---------------------------------------------------------------- orders
if longCond
    stopL = close - atr * slMult
    tgtL  = close + atr * tpMult
    strategy.entry("Long", strategy.long)
    strategy.exit("Long exit", "Long", stop = stopL, limit = tgtL)
    tradesToday += 1
    alert('{"action":"buy","symbol":"' + syminfo.ticker + '","qty":1,"stop":' + str.tostring(stopL) + ',"target":' + str.tostring(tgtL) + '}', alert.freq_once_per_bar_close)

if shortCond
    stopS = close + atr * slMult
    tgtS  = close - atr * tpMult
    strategy.entry("Short", strategy.short)
    strategy.exit("Short exit", "Short", stop = stopS, limit = tgtS)
    tradesToday += 1
    alert('{"action":"sell","symbol":"' + syminfo.ticker + '","qty":1,"stop":' + str.tostring(stopS) + ',"target":' + str.tostring(tgtS) + '}', alert.freq_once_per_bar_close)

// signal reversal exit
if strategy.position_size > 0 and score <= -2
    strategy.close("Long", comment = "Score flip")
    alert('{"action":"close","symbol":"' + syminfo.ticker + '"}', alert.freq_once_per_bar_close)
if strategy.position_size < 0 and score >= 2
    strategy.close("Short", comment = "Score flip")
    alert('{"action":"close","symbol":"' + syminfo.ticker + '"}', alert.freq_once_per_bar_close)

// end of day / loss limit: go flat at this bar's close (immediately = true), not at the next bar's open,
// which on a regular-hours chart could be the next morning's open
if strategy.position_size != 0 and (not inHold or lossHit)
    strategy.close_all(comment = lossHit ? "Loss limit" : "End of day", immediately = true)
    alert('{"action":"close","symbol":"' + syminfo.ticker + '"}', alert.freq_once_per_bar_close)

// ---------------------------------------------------------------- visuals
plot(vwapV, "VWAP", color = color.yellow, linewidth = 2)
plot(ema20, "EMA 20", color = color.aqua)
plot(ema50, "EMA 50", color = color.orange)
plot(orReady ? orH : na, "OR high", color = color.teal, style = plot.style_linebr)
plot(orReady ? orL : na, "OR low", color = color.red, style = plot.style_linebr)
bgcolor(inTrade and score >= minScore ? color.new(color.teal, 92) : inTrade and score <= -minScore ? color.new(color.red, 92) : na)

var table t = table.new(position.top_right, 2, 8, border_width = 1, bgcolor = color.new(color.black, 20))
cell(r, a, b, col) =>
    table.cell(t, 0, r, a, text_color = color.white, text_size = size.small)
    table.cell(t, 1, r, b, text_color = col, text_size = size.small)
if barstate.islast
    status = lossHit ? "STOPPED (loss limit)" : not inHold ? "Closed (outside session)" : not orReady ? "Waiting for opening range" : tradesToday >= maxTrades ? "Done (max trades)" : strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "Scanning"
    scol = score >= minScore ? color.teal : score <= -minScore ? color.red : color.white
    cell(0, "Status", status, color.yellow)
    cell(1, "Score (-4..+4)", str.tostring(score), scol)
    cell(2, "P(next up)", str.tostring(pUp * 100, "0.0") + "%", pUp >= pTh ? color.teal : pUp <= 1 - pTh ? color.red : color.white)
    cell(3, "Momentum z", str.tostring(momZ, "0.00"), color.white)
    cell(4, "VWAP z", str.tostring(vwapZ, "0.00"), math.abs(vwapZ) > maxZ ? color.orange : color.white)
    cell(5, "Rel. volume", str.tostring(relVol, "0.00"), relVol >= relVolMin ? color.teal : color.gray)
    cell(6, "Trades today", str.tostring(tradesToday) + " / " + str.tostring(maxTrades), color.white)
    cell(7, "Day P&L", "$" + str.tostring(dayPnL, "0.00"), dayPnL >= 0 ? color.teal : color.red)
