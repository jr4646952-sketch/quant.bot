//@version=6
// Quant Buy/Sell Signals: live BUY / SELL labels on the chart, with stop, target and alerts.
// Works on any market and timeframe. Signals are fixed when a candle closes (no repainting).
//
// Score from -4 to +4, one vote each:
//   Trend       EMA 20 vs EMA 50, and price vs VWAP
//   Momentum    volatility-adjusted momentum z-score
//   Breakout    close above / below the last N candles' high / low
//   Probability Naive Bayes P(next candle up), learned walk-forward
// BUY at score >= +3, SELL at score <= -3. Exit at ATR stop, ATR target, or when the score flips.
// Research tool, not financial advice.
indicator("Quant Buy/Sell Signals", shorttitle = "QBS", overlay = true, max_labels_count = 500)

minScore = input.int(3, "Score needed for a signal (1-4)", minval = 1, maxval = 4)
pTh      = input.float(0.55, "Probability vote threshold", minval = 0.5, maxval = 0.9, step = 0.01)
momLen   = input.int(10, "Momentum length", minval = 2)
brkLen   = input.int(20, "Breakout lookback (candles)", minval = 2)
slMult   = input.float(1.5, "Stop loss (x ATR)", minval = 0.1, step = 0.1)
tpMult   = input.float(2.5, "Take profit (x ATR)", minval = 0.1, step = 0.1)
showSell = input.bool(true, "Show SELL (short) signals")

// ---------------------------------------------------------------- quant inputs
atr    = ta.atr(14)
ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
vwapV  = ta.vwap(hlc3)
ret    = math.log(close / close[1])
volRet = ta.stdev(ret, 100)
momZ   = volRet > 0 ? math.log(close / close[momLen]) / (volRet * math.sqrt(momLen)) : 0.0
hiN    = ta.highest(high, brkLen)[1]
loN    = ta.lowest(low, brkLen)[1]

nbProb() =>
    int y = close > close[1] ? 1 : 0
    float r = ta.rsi(close, 14)
    int b1 = na(r) ? 1 : r < 40 ? 0 : r > 60 ? 2 : 1
    float clv = high > low ? (2 * close - high - low) / (high - low) : 0.0
    int b2 = clv < -0.33 ? 0 : clv > 0.33 ? 2 : 1
    int b3 = close > nz(ta.ema(close, 50), close) ? 1 : 0
    int b4 = 2 * nz(y[1]) + y
    int b5 = nz(volume) > nz(ta.sma(nz(volume), 20)) ? 1 : 0
    var array<float> cls = array.new<float>(2, 0.0)
    var array<float> cnt = array.new<float>(28, 0.0)
    sizes = array.from(3.0, 3.0, 2.0, 4.0, 2.0)
    prevIdx = array.from(nz(b1[1], 1), 3 + nz(b2[1], 1), 6 + nz(b3[1], 0), 8 + nz(b4[1], 0), 12 + nz(b5[1], 0))
    if bar_index > 2
        for i = 0 to 1
            cls.set(i, cls.get(i) * 0.997)
        for i = 0 to 27
            cnt.set(i, cnt.get(i) * 0.997)
        cls.set(y, cls.get(y) + 1.0)
        for i = 0 to 4
            k = y * 14 + prevIdx.get(i)
            cnt.set(k, cnt.get(k) + 1.0)
    nowIdx = array.from(b1, 3 + b2, 6 + b3, 8 + b4, 12 + b5)
    n0 = cls.get(0)
    n1 = cls.get(1)
    float lp0 = math.log((n0 + 1.0) / (n0 + n1 + 2.0))
    float lp1 = math.log((n1 + 1.0) / (n0 + n1 + 2.0))
    for i = 0 to 4
        j = nowIdx.get(i)
        lp0 += math.log((cnt.get(j) + 1.0) / (n0 + sizes.get(i)))
        lp1 += math.log((cnt.get(14 + j) + 1.0) / (n1 + sizes.get(i)))
    1.0 / (1.0 + math.exp(math.max(-30.0, math.min(30.0, lp0 - lp1))))

pUp = nbProb()

// ---------------------------------------------------------------- score
aboveV = na(vwapV) or close > vwapV
belowV = na(vwapV) or close < vwapV
vTrend = ema20 > ema50 and aboveV ? 1 : ema20 < ema50 and belowV ? -1 : 0
vMom   = momZ > 0.5 ? 1 : momZ < -0.5 ? -1 : 0
vBrk   = close > hiN ? 1 : close < loN ? -1 : 0
vProb  = pUp >= pTh ? 1 : pUp <= 1 - pTh ? -1 : 0
score  = vTrend + vMom + vBrk + vProb

// ---------------------------------------------------------------- signal state
var int   pos    = 0        // 1 = in a BUY, -1 = in a SELL, 0 = waiting
var float entry  = na
var float stopP  = na
var float tgtP   = na
var int   wins   = 0
var int   losses = 0
bool   buySig  = false
bool   sellSig = false
bool   exitSig = false
string exitTxt = ""

if barstate.isconfirmed and not na(atr)
    float exitPx = na
    if pos == 1
        if low <= stopP
            exitPx := stopP
            exitTxt := "Stop"
        else if high >= tgtP
            exitPx := tgtP
            exitTxt := "Target"
        else if score <= -2
            exitPx := close
            exitTxt := "Exit"
    else if pos == -1
        if high >= stopP
            exitPx := stopP
            exitTxt := "Stop"
        else if low <= tgtP
            exitPx := tgtP
            exitTxt := "Target"
        else if score >= 2
            exitPx := close
            exitTxt := "Exit"
    if not na(exitPx)
        exitSig := true
        if pos * (exitPx - entry) > 0
            wins += 1
        else
            losses += 1
        pos := 0
    else if pos == 0
        if score >= minScore
            buySig := true
            pos := 1
            entry := close
            stopP := close - atr * slMult
            tgtP := close + atr * tpMult
        else if showSell and score <= -minScore
            sellSig := true
            pos := -1
            entry := close
            stopP := close + atr * slMult
            tgtP := close - atr * tpMult

// ---------------------------------------------------------------- chart
if buySig
    label.new(bar_index, low, "BUY", yloc = yloc.belowbar, style = label.style_label_up, color = color.teal, textcolor = color.white, size = size.normal)
if sellSig
    label.new(bar_index, high, "SELL", yloc = yloc.abovebar, style = label.style_label_down, color = color.red, textcolor = color.white, size = size.normal)
if exitSig
    label.new(bar_index, high, exitTxt, yloc = yloc.abovebar, style = label.style_label_down, color = color.gray, textcolor = color.white, size = size.small)

plot(ema20, "EMA 20", color = color.aqua)
plot(ema50, "EMA 50", color = color.orange)
plot(pos != 0 ? stopP : na, "Stop", color = color.red, style = plot.style_linebr, linewidth = 2)
plot(pos != 0 ? tgtP : na, "Target", color = color.teal, style = plot.style_linebr, linewidth = 2)
plot(pos != 0 ? entry : na, "Entry", color = color.gray, style = plot.style_linebr)
bgcolor(pos == 1 ? color.new(color.teal, 93) : pos == -1 ? color.new(color.red, 93) : na)

alertcondition(buySig, "BUY", "QBS BUY {{ticker}} at {{close}}")
alertcondition(sellSig, "SELL", "QBS SELL {{ticker}} at {{close}}")
alertcondition(exitSig, "EXIT", "QBS EXIT {{ticker}} at {{close}}")

// ---------------------------------------------------------------- table
var table t = table.new(position.top_right, 2, 7, border_width = 1, bgcolor = color.new(color.black, 20))
cell(r, a, b, col) =>
    table.cell(t, 0, r, a, text_color = color.white, text_size = size.small)
    table.cell(t, 1, r, b, text_color = col, text_size = size.small)
if barstate.islast
    sigTxt = buySig ? "BUY NOW" : sellSig ? "SELL NOW" : pos == 1 ? "In BUY (hold)" : pos == -1 ? "In SELL (hold)" : "WAIT"
    sigCol = pos == 1 ? color.teal : pos == -1 ? color.red : color.yellow
    total = wins + losses
    cell(0, "Signal", sigTxt, sigCol)
    cell(1, "Score (-4..+4)", str.tostring(score), score >= minScore ? color.teal : score <= -minScore ? color.red : color.white)
    cell(2, "P(next up)", str.tostring(pUp * 100, "0.0") + "%", color.white)
    cell(3, "Entry", pos != 0 ? str.tostring(entry, format.mintick) : "-", color.white)
    cell(4, "Stop", pos != 0 ? str.tostring(stopP, format.mintick) : "-", color.red)
    cell(5, "Target", pos != 0 ? str.tostring(tgtP, format.mintick) : "-", color.teal)
    cell(6, "Past signals", total > 0 ? str.tostring(total) + ", " + str.tostring(100.0 * wins / total, "0") + "% won" : "none yet", color.white)
